# Telegram Bot Token — از BotFather بگیرید (@BotFather → /newbot)
# برای Python polling؛ در WordPress webhook همین توکن را با نام AHANGBAN_BOT_TOKEN
# در محیط PHP-FPM/هاست تنظیم کنید. این فایل فقط نمونهٔ سرویس Python است.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# آدرس پایه API افزونهٔ وردپرس (HTTPS و بدون اسلش انتهایی)
AHANGBAN_API_BASE=https://ahangban.ir/wp-json/ahangban/v1

# توکن مشترک API: یک مقدار تصادفی ۶۴رقمی hex را هم در محیط PHP با همین نام
# و هم در این فایل خصوصی وارد کنید. مقدار واقعی را هرگز commit نکنید.
AHANGBAN_API_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# شناسهٔ عددی ادمین(ها) — با کاما جدا کنید (برای /admin و broadcast)
# مقدار واقعی را از حساب تلگرام خود بگیرید؛ نمونهٔ ساختگی در فایل پیش‌فرض نیست.
ADMIN_IDS=

LOG_LEVEL=INFO
# حافظهٔ نهان ربات (ثانیه)
CACHE_TTL=300
# محدودیت نرخ کاربر (پیام در دقیقه)
RATE_LIMIT_PER_MINUTE=20

# در محیط PHP هاست: برای WordPress webhook یا ارسال دستی به کانال از API.
# در حالت Python polling نیز AHANGBAN_BOT_TOKEN باید در PHP باشد تا افزونه بتواند پیام کانال را ارسال کند.
# AHANGBAN_BOT_TOKEN=...
# AHANGBAN_BOT_SECRET=REPLACE WITH A RANDOM 64-HEX VALUE
# AHANGBAN_API_TOKEN=REPLACE_WITH_THE_SAME_64_HEX_VALUE_AS_ABOVE
# AHANGBAN_TRUSTED_PROXY_IPS=203.0.113.0/24,2001:db8::/32
