# Telegram Bot Token — از BotFather بگیرید (@BotFather → /newbot)
BOT_TOKEN=123456:ABC-DEF...

# آدرس پایه API افزونهٔ وردپرس (بدون اسلش انتهایی)
# مثال: https://ahangban.ir/wp-json/ahangban/v1
AHANGBAN_API_BASE=https://ahangban.ir/wp-json/ahangban/v1

# توکن افزونه — از پیشخوان وردپرس → آهنگ‌بان API کپی کنید
AHANGBAN_API_TOKEN=your-64-hex-token-here

# شناسهٔ عددی ادمین(ها) — با کاما جدا کنید (برای /admin و broadcast)
ADMIN_IDS=123456789,987654321

# اختیاری
BOT_USERNAME=ahangbanbot
LOG_LEVEL=INFO
# حافظهٔ نهان ربات (ثانیه)
CACHE_TTL=300
# محدودیت نرخ کاربر (پیام در دقیقه)
RATE_LIMIT_PER_MINUTE=20
