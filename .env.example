# Telegram Bot Token — از BotFather بگیرید (@BotFather → /newbot)
# برای Python polling؛ در WordPress webhook همین توکن را با نام AHANGBAN_BOT_TOKEN
# در محیط PHP یا فرم اعتبارنامه‌های افزونه تنظیم کنید. PHP این فایل را خودکار نمی‌خواند.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# نام قدیمیِ سازگار؛ فقط در صورت نیاز به سازگاری با استقرار فعلی استفاده کنید.
# BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# PaaS web/health port (binds to 0.0.0.0); match the port in the PaaS app settings.
PORT=8000

# آدرس پایه API افزونهٔ وردپرس (HTTPS و بدون اسلش انتهایی)
AHANGBAN_API_BASE=https://ahangban.ir/wp-json/ahangban/v1

# مسیر API حساب Taranehyar؛ اگر خالی بماند از AHANGBAN_API_BASE مشتق می‌شود.
# مسیرِ استاندارد در قالب v3.11.0: /wp-json/tara/v1
# TARA_API_BASE=https://ahangban.ir/wp-json/tara/v1

# توکن مشترک API: در Python polling باید با مقدار PHP (محیط یا فرم افزونه) یکسان باشد.
# یک مقدار تصادفی ۶۴رقمی hex وارد کنید؛ مقدار واقعی را هرگز commit نکنید.
AHANGBAN_API_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS

# شناسهٔ عددی ادمین(ها) — با کاما جدا کنید (برای /admin و broadcast)
# مقدار واقعی را از حساب تلگرام خود بگیرید؛ نمونهٔ ساختگی در فایل پیش‌فرض نیست.
ADMIN_IDS=

LOG_LEVEL=INFO
# حافظهٔ نهان ربات (ثانیه)
CACHE_TTL=300
# محدودیت نرخ کاربر (پیام در دقیقه)
RATE_LIMIT_PER_MINUTE=20
# Optional: set only when the PaaS provides a persistent writable disk.
# AHANGBAN_DB_PATH=/data/ahangban.db

# اختیاری برای محیط PHP هاست؛ در نبود این متغیرها v1.5.2 از فرم افزونه استفاده می‌کند.
# این فایل توسط PHP خودکار خوانده نمی‌شود. در webhook، توکن و secret در فرم یا env افزونه تنظیم شوند.
# AHANGBAN_BOT_TOKEN=...
# AHANGBAN_BOT_SECRET=REPLACE_WITH_A_RANDOM_64_HEX_VALUE
# AHANGBAN_API_TOKEN=REPLACE_WITH_THE_SAME_64_HEX_VALUE_AS_ABOVE
# AHANGBAN_TRUSTED_PROXY_IPS=203.0.113.0/24,2001:db8::/32
